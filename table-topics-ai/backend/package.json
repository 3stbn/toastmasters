{
  "name": "table-topics-ai-api",
  "type": "module",
  "scripts": {
    "cf": "sh scripts/wrangler.sh",
    "dev": "sh scripts/wrangler.sh dev --port 8787",
    "deploy": "sh scripts/wrangler.sh deploy --minify",
    "lint": "tsc --noEmit",
    "gen-types": "sh scripts/wrangler.sh types src/env.d.ts",
    "eval": "tsx scripts/eval.ts",
