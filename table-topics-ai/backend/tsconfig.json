{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src", "../shared"],
  "exclude": ["node_modules", "scripts"]
}
